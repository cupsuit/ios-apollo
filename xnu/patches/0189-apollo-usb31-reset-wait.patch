+/*
+ * apollo (xnu 0189): the Mi 10T's device tree puts the controller behind the apps SMMU (ssusb iommus =
+ * <&apps_smmu 0x0 0x0>, qcom,iommu-dma "atomic"), while this driver gives it physical addresses. What the
+ * stream (SID 0) gets after ABL, read only: sCR0 (CLIENTPD bit 0 = SMMU off, USFCFG bit 10 = unmatched
+ * streams fault), and every valid SMR that matches SID 0 with its S2CR (type 0 translate, 1 bypass,
+ * 2 fault; CBNDX bits 7:0). Register layout: ARM SMMUv2 global space 0 (Linux arm-smmu.h).
+ */
+#define APPS_SMMU_PA            0x15000000
+static void
+sweet_usb_smmu_report(void)
+{
+	vm_offset_t smmu = ml_io_map(APPS_SMMU_PA, 0x1000);
+	if (smmu == 0) {
+		printf("SWEET USB: apps SMMU map failed\n");
+		return;
+	}
+	uint32_t scr0 = usb_rd(smmu, 0x0), idr0 = usb_rd(smmu, 0x20);
+	unsigned nsmr = idr0 & 0xffu, matched = 0;
+	printf("SWEET USB: apps SMMU sCR0 0x%08x (CLIENTPD %u USFCFG %u) IDR0 0x%08x (%u SMRs)\n",
+	    scr0, scr0 & 1u, (scr0 >> 10) & 1u, idr0, nsmr);
+	for (unsigned n = 0; n < nsmr && n < 128; n++) {
+		uint32_t smr = usb_rd(smmu, 0x800 + 4 * n);
+		uint32_t id = smr & 0xffffu, mask = (smr >> 16) & 0x7fffu;
+		if (!(smr & (1u << 31)) || (id & ~mask) != 0) {
+			continue;
+		}
+		uint32_t s2cr = usb_rd(smmu, 0xc00 + 4 * n);
+		printf("SWEET USB: SMR%u 0x%08x (id 0x%x mask 0x%x) S2CR 0x%08x (type %u, CB %u)\n",
+		    n, smr, id, mask, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+		matched++;
+	}
+	if (matched == 0) {
+		printf("SWEET USB: no SMR matches SID 0: %s\n", (scr0 >> 10) & 1u ? "unmatched streams FAULT" : "unmatched streams bypass");
+	}
+}
